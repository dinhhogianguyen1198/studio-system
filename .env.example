# Cloudflare D1 uses the DB binding in wrangler.jsonc; no DATABASE_URL is needed.
# Development: copy to .env. Production: configure these as Worker variables/secrets.
# Generate AUTH_SECRET locally: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
AUTH_URL="http://localhost:3000"

# Required only while bootstrapping an owner account. Never commit real values.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Only for npm run seed:remote on an operator's machine; not needed in the Worker.
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_DATABASE_ID=""
# CLOUDFLARE_API_TOKEN=""
